# Local SQLite database. Use persistent storage for a self-hosted development instance.
DATABASE_PATH=.data/context.sqlite
# Set to 1 only behind HTTPS. Leave unset for local HTTP development.
SECURE_COOKIES=0
# Enable a separate no-email local test profile from /pilot.
# Off by default for production; npm run local enables it for local use.
LOCAL_DEMO_ENABLED=0
